{
  "name": "convertilocal",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Suite de herramientas de conversión 100% client-side. Tus archivos nunca salen de tu dispositivo.",
  "scripts": {
    "sync:pdf": "node scripts/sync-pdf-assets.mjs",
    "sync:media": "node scripts/sync-media-assets.mjs",
    "sync:bg": "node scripts/sync-bg-assets.mjs",
    "predev": "npm run sync:pdf && npm run sync:media && npm run sync:bg",
    "prestart": "npm run sync:pdf && npm run sync:media && npm run sync:bg",
    "prebuild": "npm run sync:pdf && npm run sync:media && npm run sync:bg",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "budget": "npm run build && node scripts/check-js-budget.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:html": "node scripts/validate-html.mjs",
    "verify:deploy": "node scripts/verify-deployment.mjs",
    "deploy:check": "npm run validate && npm run verify:deploy",
    "test:e2e": "node scripts/generate-test-fixtures.mjs && playwright test",
    "validate": "npm run check && npm run lint && npm run validate:content && npm run budget && npm run validate:html"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/tailwind": "^6.0.2",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@imgly/background-removal": "^1.7.0",
    "@jsquash/avif": "^2.1.1",
    "astro": "^5.18.2",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "heic2any": "^0.0.4",
    "js-yaml": "^5.5.0",
    "marked": "^18.1.1",
    "onnxruntime-web": "1.21.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "tailwindcss": "^3.4.19",
    "turndown": "^7.2.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "ffmpeg-static": "^5.3.0",
    "globals": "^16.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
