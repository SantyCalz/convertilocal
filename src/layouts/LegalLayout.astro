import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import { LEGAL_LINKS, type LegalPage } from '@/data/site';

interface Props {
  page: LegalPage;
}

const { page } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(page.updated));

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Inicio',
      item: new URL('/', Astro.site ?? 'https://convertilocal.com').href,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: page.title,
      item: new URL(page.path, Astro.site ?? 'https://convertilocal.com').href,
    },
  ],
};
---

<BaseLayout
  title={page.title}
  description={page.description}
  path={page.path}
  ogType="article"
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema).replace(/</g, '\\u003c')}
    />
  </Fragment>

  <div class="border-b border-slate-200 bg-white">
    <div class="container-page py-9 sm:py-12">
      <nav aria-label="Migas de pan" class="text-xs text-slate-500">
        <ol class="flex flex-wrap items-center gap-1.5">
          <li><a href="/" class="hover:text-slate-900">Inicio</a></li>
          <li aria-hidden="true" class="text-slate-300">/</li>
          <li aria-current="page" class="text-slate-700">{page.title}</li>
        </ol>
      </nav>

      <h1 class="mt-5 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        {page.title}
      </h1>
      <p class="mt-3 max-w-2xl text-base leading-7 text-slate-600">{page.description}</p>
      <p class="mt-4 flex items-center gap-1.5 text-xs text-slate-500">
        <Icon name="clock" size={14} />
        Última actualización:
        <time datetime={page.updated} class="font-medium text-slate-600">{formattedDate}</time>
      </p>
    </div>
  </div>

  <div class="container-page grid gap-10 py-10 lg:grid-cols-[minmax(0,1fr)_17rem] lg:py-14">
    <article class="prose-legal min-w-0 max-w-3xl">
      <slot />
    </article>

    <aside class="lg:pt-1" aria-label="Documentos legales">
      <div class="rounded-2xl border border-slate-200 bg-white p-5 lg:sticky lg:top-20">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-400">
          Documentos legales
        </p>
        <nav aria-label="Otros documentos legales" class="mt-3">
          <ul class="space-y-1">
            {
              LEGAL_LINKS.map((link) => (
                <li>
                  <a
                    href={link.href}
                    aria-current={link.href === page.path ? 'page' : undefined}
                    class:list={[
                      'block rounded-lg px-2.5 py-1.5 text-sm transition-colors',
                      link.href === page.path
                        ? 'bg-brand-50 font-medium text-brand-800'
                        : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900',
                    ]}
                  >
                    {link.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="mt-5 border-t border-slate-100 pt-4">
          <p class="text-sm font-medium text-slate-900">¿Tienes dudas?</p>
          <p class="mt-1 text-xs leading-5 text-slate-500">
            Escríbenos y te responderemos en horario laboral.
          </p>
          <a
            href="/contacto"
            class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:text-brand-800"
          >
            Ir a contacto
            <Icon name="arrow-right" size={15} />
          </a>
        </div>
      </div>
    </aside>
  </div>
</BaseLayout>
