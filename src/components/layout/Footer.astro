---
import { FOOTER_PROJECT_LINKS, FOOTER_TOOL_LINKS } from '@/data/nav';
import { FOOTER_LEGAL_LINKS, SITE } from '@/data/site';
import Icon from '@/components/ui/Icon.astro';
import Logo from '@/components/ui/Logo.astro';

const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-slate-200 bg-white">
  <div class="container-page py-12">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-4">
        <a href="/" class="inline-flex rounded-lg" aria-label="ConvertiLocal, ir al inicio">
          <Logo />
        </a>
        <p class="mt-4 max-w-xs text-sm leading-6 text-slate-500">
          Herramientas de conversión que funcionan dentro de tu navegador. Sin subidas, sin cuentas
          y sin esperas.
        </p>
        <p
          class="mt-4 inline-flex items-center gap-1.5 rounded-full bg-brand-50 px-3 py-1.5 text-xs font-medium text-brand-800 ring-1 ring-inset ring-brand-100"
        >
          <Icon name="shield" size={14} />
          0 archivos subidos
        </p>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 md:col-span-8">
        <div>
          <h2 class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-400">
            Herramientas
          </h2>
          <ul class="mt-3 space-y-2.5">
            {
              FOOTER_TOOL_LINKS.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-slate-600 transition-colors hover:text-brand-800"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h2 class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-400">
            Proyecto
          </h2>
          <ul class="mt-3 space-y-2.5">
            {
              FOOTER_PROJECT_LINKS.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-slate-600 transition-colors hover:text-brand-800"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="col-span-2 sm:col-span-1">
          <h2 class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-400">Legal</h2>
          <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2.5 sm:grid-cols-1">
            {
              FOOTER_LEGAL_LINKS.map((link) => (
                <li>
                  <a
                    href={link.href}
                    title={link.title}
                    class="text-sm text-slate-600 transition-colors hover:text-brand-800"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col gap-3 border-t border-slate-100 pt-6 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {SITE.name}. Hecho para funcionar sin conexión.</p>
      <p class="flex items-center gap-1.5">
        <Icon name="lock" size={14} />
        Tus archivos nunca salen de tu dispositivo.
      </p>
    </div>
  </div>
</footer>
