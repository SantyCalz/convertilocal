import { LEGAL_ENTITY, SITE_URL, SOURCE_RELEASE_URL } from '@/data/site';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import type { LegalBlock, LegalDocument } from '@/content/legal/types';

interface Props {
  document: LegalDocument;
  /**
   * Componentes extra que se insertan al final de una sección concreta,
   * indexados por el id de la sección.
   */
  extras?: Record<string, AstroComponentFactory>;
}

const { document, extras = {} } = Astro.props;

/**
 * Sustituye las referencias a datos externos por sus valores reales:
 * `LEGAL_ENTITY.<campo>`, `SITE_URL` y `RELEASE_URL`.
 */
const resolve = (value: string): string =>
  value
    .replace(/LEGAL_ENTITY\.(\w+)/g, (_, key: string) => {
      const found = (LEGAL_ENTITY as Record<string, string>)[key];
      return found ?? '';
    })
    .replace(/SITE_URL/g, SITE_URL)
    .replace(/RELEASE_URL/g, SOURCE_RELEASE_URL);

const renderList = (items: string[]): string[] => items.map((item) => resolve(item));

const renderFacts = (pairs: [string, string][]): [string, string][] =>
  pairs.map(([term, value]) => [resolve(term), resolve(value)]);

const resolveBlock = (block: LegalBlock): string =>
  block.type === 'paragraph' || block.type === 'note'
    ? resolve(block.content as string)
    : '';
---

{
  document.sections.map((section) => {
    const Extra = extras[section.id];
    return (
      <section id={section.id} class="mt-8 first:mt-0">
        <h2 class="text-xl font-bold tracking-tight text-slate-900">{section.title}</h2>

        {section.blocks.map((block) => (
          <>
            {block.type === 'paragraph' && (
              <p class="mt-3 text-sm leading-7 text-slate-600">{resolveBlock(block)}</p>
            )}

            {block.type === 'note' && (
              <p class="mt-3 rounded-xl border border-brand-100 bg-brand-50/60 px-4 py-3 text-sm leading-6 text-brand-900">
                {resolveBlock(block)}
              </p>
            )}

            {block.type === 'list' && (
              <ul class="mt-3 space-y-2 text-sm leading-6 text-slate-600">
                {renderList(block.content as string[]).map((item) => (
                  <li class="flex gap-2">
                    <span aria-hidden="true" class="mt-2 h-1 w-1 shrink-0 rounded-full bg-slate-400" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            )}

            {block.type === 'facts' && (
              <dl class="mt-3 overflow-hidden rounded-xl border border-slate-200">
                {renderFacts(block.content as [string, string][]).map(([term, value], index) => (
                  <div
                    class:list={[
                      'grid gap-1 px-4 py-3 text-sm sm:grid-cols-[13rem_minmax(0,1fr)] sm:gap-4',
                      index % 2 === 0 ? 'bg-slate-50/70' : 'bg-white',
                    ]}
                  >
                    <dt class="font-medium text-slate-700">{term}</dt>
                    <dd class="leading-6 text-slate-600">{value}</dd>
                  </div>
                ))}
              </dl>
            )}
          </>
        ))}

        {Extra && <Extra />}
      </section>
    );
  })
}
