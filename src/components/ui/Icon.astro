    '<path d="M3 4l18 18"/><path d="M8.5 16.5a5 5 0 0 1 7 0"/><path d="M5 13a10 10 0 0 1 3-2M19 13a10 10 0 0 0-3.5-2.3"/><path d="M2 9a15 15 0 0 1 4-2.5M22 9a15 15 0 0 0-9-4"/><circle cx="12" cy="20" r=".5"/>',
  x: '<path d="m6 6 12 12M18 6 6 18"/>',
