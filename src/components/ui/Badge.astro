interface Props {
  variant?: 'neutral' | 'brand' | 'success' | 'warning' | 'outline';
  class?: string;
}

const { variant = 'neutral', class: className = '' } = Astro.props;

const variants = {
  neutral: 'bg-slate-100 text-slate-600 ring-slate-200',
  brand: 'bg-brand-50 text-brand-700 ring-brand-200',
  success: 'bg-emerald-50 text-emerald-700 ring-emerald-200',
  warning: 'bg-amber-50 text-amber-700 ring-amber-200',
  outline: 'bg-transparent text-slate-500 ring-slate-300',
};
---

<span
  class:list={[
    'inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-[11px] font-semibold leading-none ring-1 ring-inset',
    variants[variant],
    className,
  ]}
>
  <slot />
</span>
