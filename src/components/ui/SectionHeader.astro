---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  id?: string;
  class?: string;
}

const { eyebrow, title, description, id, class: className = '' } = Astro.props;
---

<div class:list={['flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between', className]}>
  <div class="max-w-2xl">
    {eyebrow && <p class="eyebrow mb-2">{eyebrow}</p>}
    <h2 id={id} class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">{title}</h2>
    {description && <p class="mt-2 text-sm leading-6 text-slate-600 sm:text-base">{description}</p>}
  </div>
  <div class="shrink-0">
    <slot name="actions" />
  </div>
</div>
