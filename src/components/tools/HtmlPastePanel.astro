import Icon from '@/components/ui/Icon.astro';

interface Props {
  /** Id del procesador al que se añaden los archivos. */
  targetId?: string;
  label?: string;
  placeholder?: string;
}

const {
  targetId = 'tool',
  label = 'O pega aquí tu código HTML',
  placeholder = '<h1>Hola</h1>\n<p>Escribe o pega tu HTML…</p>',
} = Astro.props;
---

<div class="mt-4 rounded-2xl border border-slate-200 bg-slate-50/60 p-4" data-html-paste>
  <label
    for={`${targetId}-html`}
    class="flex items-center gap-1.5 text-sm font-semibold text-slate-900"
  >
    <Icon name="code" size={15} class="text-slate-400" />
    {label}
  </label>
  <p class="mt-1 text-xs leading-5 text-slate-500">
    También puedes subir un archivo <code class="rounded bg-white px-1 py-0.5 text-[11px]">.html</code>.
    Los scripts, los marcos y los enlaces externos se eliminan antes de generar el PDF.
  </p>
  <textarea
    id={`${targetId}-html`}
    data-html-source
    rows="6"
    spellcheck="false"
    placeholder={placeholder}
    class="mt-3 w-full resize-y rounded-xl border border-slate-300 bg-white px-3 py-2 font-mono text-xs leading-5 text-slate-800 shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30"
  ></textarea>
  <div class="mt-3 flex flex-wrap items-center gap-3">
    <button
      type="button"
      data-html-use
      class="inline-flex h-10 items-center gap-1.5 rounded-xl bg-brand-700 px-4 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-800"
    >
      Usar este HTML
      <Icon name="arrow-right" size={14} />
    </button>
    <p data-html-status class="text-xs text-slate-500" role="status" aria-live="polite"></p>
  </div>
</div>

<script>
  const panel = document.querySelector<HTMLElement>('[data-html-paste]');
  const textarea = panel?.querySelector<HTMLTextAreaElement>('[data-html-source]');
  const button = panel?.querySelector<HTMLButtonElement>('[data-html-use]');
  const status = panel?.querySelector<HTMLElement>('[data-html-status]');

  button?.addEventListener('click', () => {
    const source = textarea?.value ?? '';
    if (!source.trim()) {
      if (status) status.textContent = 'Escribe o pega algo antes de continuar.';
      return;
    }

    const root = document.querySelector<HTMLElement>('[data-file-processor]');
    if (!root) return;

    const file = new File([source], 'html-pegado.html', {
      type: 'text/html',
      lastModified: Date.now(),
    });

    root.dispatchEvent(
      new CustomEvent('convertilocal:add-files', { bubbles: true, detail: { files: [file] } }),
    );

    if (status) {
      status.textContent = 'Añadido a la lista. Pulsa «Generar PDF».';
    }
  });
</script>
