 */
interface Props {
  id?: string;
  /** Texto del encabezado del panel. */
  title?: string;
}
const { id = 'image-compare', title = 'Vista previa antes y después' } = Astro.props;
---

<section
  id={id}
  data-image-compare
  hidden
  class="mt-5 overflow-hidden rounded-2xl border border-slate-200 bg-white"
>
  <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 px-4 py-3">
    <h2 class="text-sm font-semibold text-slate-900">{title}</h2>
    <p data-compare-hint class="text-[11px] text-slate-400">
      Arrastra el deslizador para comparar
    </p>
  </div>

  <div
    data-compare-stage
    class="relative aspect-video w-full touch-none select-none overflow-hidden bg-slate-100"
  >
    <img
      data-compare-before
      alt="Imagen original"
      decoding="async"
      class="pointer-events-none absolute inset-0 h-full w-full object-contain"
    />

    <!--
      Capa del resultado: el recorte se aplica al contenedor para que el
      entramado y la imagen se recorten siempre con la misma geometría.
    -->
    <div
      data-compare-after-layer
      class="pointer-events-none absolute inset-0"
      style="clip-path: inset(0 0 0 50%);"
    >
      <!-- Entramado de transparencia: sizing en JS para encajar con la imagen. -->
      <div data-compare-backdrop class="absolute opacity-0"></div>
      <img
        data-compare-after
        alt="Imagen procesado"
        decoding="async"
        class="absolute inset-0 h-full w-full object-contain"
      />
    </div>

    <div
      data-compare-handle
      aria-hidden="true"
      class="pointer-events-none absolute inset-y-0 w-0.5 bg-white shadow-[0_0_0_1px_rgba(15,23,42,0.35)]"
      style="left: 50%;"
    >
      <span
        class="absolute left-1/2 top-1/2 flex h-9 w-9 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white text-xs font-bold text-slate-700 shadow-lg"
      >
        ↔
      </span>
    </div>
    <span
      data-compare-label-before
      class="pointer-events-none absolute left-2 top-2 rounded-full bg-slate-900/70 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-white"
    >
      Antes
    </span>
    <span
      data-compare-label-after
      class="pointer-events-none absolute right-2 top-2 rounded-full bg-slate-900/70 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-white"
    >
      Después
    </span>
  </div>

  <div class="border-t border-slate-100 px-4 py-3">
    <label class="sr-only" for={`${id}-slider`}>Posición del deslizador de comparación</label>
    <input
      id={`${id}-slider`}
      data-compare-slider
      type="range"
      min="0"
      max="100"
      value="50"
      step="0.5"
      aria-label="Comparar antes y después"
      class="h-8 w-full cursor-ew-resize accent-brand-700"
    />
  </div>
</section>

<style>
  /* Entramado clásico para apreciar el canal alfa de un PNG. */
  [data-compare-backdrop] {
    background-color: #f8fafc;
    background-image:
      linear-gradient(45deg, #cbd5e1 25%, transparent 25%),
      linear-gradient(-45deg, #cbd5e1 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, #cbd5e1 75%),
      linear-gradient(-45deg, transparent 75%, #cbd5e1 75%);
    background-size: 16px 16px;
    background-position:
      0 0,
      0 8px,
      8px -8px,
      -8px 0;
  }
</style>

<script>
  interface CompareDetail {
    beforeUrl?: string;
    afterUrl?: string;
  }

  const applyPosition = (root: HTMLElement, percent: number): void => {
    const clamped = Math.max(0, Math.min(100, percent));
    const layer = root.querySelector<HTMLElement>('[data-compare-after-layer]');
    const handle = root.querySelector<HTMLElement>('[data-compare-handle]');
    // La imagen original queda a la izquierda y el resultado a la derecha.
    if (layer) layer.style.clipPath = `inset(0 0 0 ${clamped}%)`;
    if (handle) handle.style.left = `${clamped}%`;
  };

  /** Encaja el entramado con el tamaño real del PNG dentro del escenario. */
  const syncBackdrop = (root: HTMLElement): void => {
    const backdrop = root.querySelector<HTMLElement>('[data-compare-backdrop]');
    const layer = root.querySelector<HTMLElement>('[data-compare-after-layer]');
    const after = root.querySelector<HTMLImageElement>('[data-compare-after]');
    if (!backdrop || !layer || !after) return;

    const naturalWidth = after.naturalWidth;
    const naturalHeight = after.naturalHeight;
    if (!naturalWidth || !naturalHeight) {
      backdrop.style.opacity = '0';
      return;
    }

    const box = layer.getBoundingClientRect();
    if (box.width === 0 || box.height === 0) return;

    const scale = Math.min(box.width / naturalWidth, box.height / naturalHeight);
    const width = naturalWidth * scale;
    const height = naturalHeight * scale;

    backdrop.style.width = `${width}px`;
    backdrop.style.height = `${height}px`;
    backdrop.style.left = `${(box.width - width) / 2}px`;
    backdrop.style.top = `${(box.height - height) / 2}px`;
    backdrop.style.opacity = '1';
  };

  const setupCompare = (root: HTMLElement): void => {
    if (root.dataset.compareReady === 'true') return;
    root.dataset.compareReady = 'true';

    const after = root.querySelector<HTMLImageElement>('[data-compare-after]');
    const slider = root.querySelector<HTMLInputElement>('[data-compare-slider]');
    const stage = root.querySelector<HTMLElement>('[data-compare-stage]');
    const layer = root.querySelector<HTMLElement>('[data-compare-after-layer]');
    if (!after || !slider || !stage || !layer) return;

    applyPosition(root, Number(slider.value));

    slider.addEventListener('input', () => {
      applyPosition(root, Number(slider.value));
    });

    after.addEventListener('load', () => syncBackdrop(root));
    if (after.complete && after.naturalWidth > 0) syncBackdrop(root);

    if (typeof ResizeObserver !== 'undefined') {
      new ResizeObserver(() => syncBackdrop(root)).observe(layer);
    } else {
      window.addEventListener('resize', () => syncBackdrop(root));
    }

    // Arrastrar sobre la imagen mueve el deslizador.
    let dragging = false;
    const moveTo = (clientX: number): void => {
      const rect = stage.getBoundingClientRect();
      if (rect.width === 0) return;
      const percent = ((clientX - rect.left) / rect.width) * 100;
      slider.value = String(Math.max(0, Math.min(100, percent)));
      applyPosition(root, Number(slider.value));
    };

    stage.addEventListener('pointerdown', (event) => {
      dragging = true;
      stage.setPointerCapture(event.pointerId);
      moveTo(event.clientX);
    });
    stage.addEventListener('pointermove', (event) => {
      if (dragging) moveTo(event.clientX);
    });
    stage.addEventListener('pointerup', (event) => {
      dragging = false;
      if (stage.hasPointerCapture(event.pointerId)) stage.releasePointerCapture(event.pointerId);
    });
    stage.addEventListener('pointercancel', () => {
      dragging = false;
    });
  };

  const showCompare = (root: HTMLElement, detail: CompareDetail): void => {
    const before = root.querySelector<HTMLImageElement>('[data-compare-before]');
    const after = root.querySelector<HTMLImageElement>('[data-compare-after]');
    if (!before || !after) return;
    if (!detail.beforeUrl || !detail.afterUrl) return;

    before.src = detail.beforeUrl;
    after.src = detail.afterUrl;
    root.hidden = false;
  };

  document.querySelectorAll<HTMLElement>('[data-image-compare]').forEach(setupCompare);

  document.addEventListener('convertilocal:processed', (event) => {
    const detail = (event as CustomEvent<CompareDetail>).detail;
    document.querySelectorAll<HTMLElement>('[data-image-compare]').forEach((root) => {
      showCompare(root, detail ?? {});
    });
  });
</script>
