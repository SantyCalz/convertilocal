---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FileProcessor from '@/components/FileProcessor.astro';
import Icon from '@/components/ui/Icon.astro';
import type { ProcessorOption } from '@/types/processor';

interface Props {
  title: string;
  description: string;
  h1: string;
  intro: string;
  path: string;
  processorId: string;
  accept: string;
  acceptLabel: string;
  actionLabel: string;
  baseName: string;
  fixedOptions?: Record<string, string | number | boolean>;
  options?: ProcessorOption[];
  resultNote?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  breadcrumbLabel: string;
  breadcrumbParent?: { href: string; label: string };
  multiple?: boolean;
  maxSizeMB?: number;
  maxFiles?: number;
  maxTotalMB?: number;
  previewMode?: 'none' | 'pdf-merge' | 'pdf-pages' | 'pdf-organize' | 'media' | 'image-compare';
}

const {
  title,
  description,
  h1,
  intro,
  path,
  processorId,
  accept,
  acceptLabel,
  actionLabel,
  baseName,
  fixedOptions = {},
  options = [],
  resultNote,
  schema,
  breadcrumbLabel,
  breadcrumbParent = { href: '/convertir', label: 'Convertir imágenes' },
  multiple = true,
  maxSizeMB = 25,
  maxFiles = 20,
  maxTotalMB = 120,
  previewMode = 'none',
} = Astro.props;
---

<BaseLayout title={title} description={description} path={path} schema={schema}>
  <div class="border-b border-slate-200 bg-white">
    <div class="container-page py-6 sm:py-9">
      <nav aria-label="Migas de pan" class="flex flex-wrap items-center gap-1.5 text-xs text-slate-400">
        <a href="/" class="transition-colors hover:text-brand-700">Inicio</a>
        <span aria-hidden="true">/</span>
        <a href={breadcrumbParent.href} class="transition-colors hover:text-brand-700">
          {breadcrumbParent.label}
        </a>
        <span aria-hidden="true">/</span>
        <span class="text-slate-600" aria-current="page">{breadcrumbLabel}</span>
      </nav>

      <div class="mt-4 grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-12">
        <div>
          <p
            class="inline-flex items-center gap-1.5 rounded-full bg-brand-50 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wide text-brand-700 ring-1 ring-inset ring-brand-100"
          >
            <Icon name="lock" size={11} />
            100% en tu navegador
          </p>
          <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-950 sm:text-4xl">
            {h1}
          </h1>
          <p class="mt-4 max-w-2xl text-sm leading-7 text-slate-600 sm:text-base">{intro}</p>
          <slot name="intro-extra" />
          <ul class="mt-5 grid gap-2 text-xs text-slate-500 sm:grid-cols-2">
            <li class="flex items-center gap-2">
              <Icon name="shield" size={15} class="text-brand-600" />
              Tus archivos no se suben
            </li>
            <li class="flex items-center gap-2">
              <Icon name="zap" size={15} class="text-brand-600" />
              Sin registro ni marcas de agua
            </li>
            <li class="flex items-center gap-2">
              <Icon name="wifi-off" size={15} class="text-brand-600" />
              Funciona sin conexión
            </li>
            <li class="flex items-center gap-2">
              <Icon name="smartphone" size={15} class="text-brand-600" />
              También en el móvil
            </li>
          </ul>
        </div>

        <div class="min-w-0">
          <FileProcessor
            id="tool"
            title={h1}
            description="Selecciona o arrastra tus archivos. Todo se procesa en este dispositivo."
            processorId={processorId}
            accept={accept}
            acceptLabel={acceptLabel}
            multiple={multiple}
            maxSizeMB={maxSizeMB}
            maxFiles={maxFiles}
            maxTotalMB={maxTotalMB}
            options={options}
            fixedOptions={fixedOptions}
            actionLabel={actionLabel}
            baseName={baseName}
            resultNote={resultNote}
            previewMode={previewMode}
          />
        </div>
      </div>
    </div>
  </div>

  <div class="container-page py-10 sm:py-14">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_280px] lg:gap-12">
      <div class="min-w-0">
        <slot />
      </div>
      <aside class="min-w-0">
        <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-5">
          <h2 class="text-sm font-semibold text-slate-900">Privacidad, sin letra pequeña</h2>
          <p class="mt-2 text-xs leading-5 text-slate-500">
            El archivo se lee con JavaScript en tu navegador y se borra de la memoria al cerrar la
            pestaña. No hay servidor, cuenta ni copia remota.
          </p>
          <a
            href="/metodologia"
            class="mt-3 inline-flex items-center gap-1.5 text-xs font-semibold text-brand-700 hover:text-brand-800"
          >
            Cómo lo verificamos
            <Icon name="arrow-right" size={13} />
          </a>
        </div>
        <slot name="aside" />
      </aside>
    </div>
  </div>
</BaseLayout>
