 * Copyright (C) 2026 ConvertiLocal contributors
 * SPDX-License-Identifier: AGPL-3.0-only
 */
import Icon from '@/components/ui/Icon.astro';
import ToolSearch from './ToolSearch.astro';
---

<section class="relative overflow-hidden border-b border-slate-200 bg-white">
  <div
    class="pointer-events-none absolute inset-0 bg-grid opacity-60 [mask-image:radial-gradient(70%_60%_at_50%_0%,black,transparent)]"
  >
  </div>
  <div class="pointer-events-none absolute inset-x-0 top-0 h-80 bg-radial-brand"></div>

  <div class="container-page relative py-10 sm:py-14 lg:py-20">
    <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-14">
      <div>
        <p
          class="inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50/80 px-3 py-1 text-[11px] font-semibold text-brand-800 sm:text-xs"
        >
          <span class="relative flex h-2 w-2">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-400 opacity-75"
            ></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-brand-600"></span>
          </span>
          100% en tu navegador · sin subidas
        </p>

        <h1
          class="mt-5 text-[2.1rem] font-extrabold leading-[1.08] tracking-tight text-slate-950 sm:text-5xl lg:text-[3.4rem]"
        >
          Tus archivos, convertidos.
          <span class="text-brand-700">Sin salir de tu dispositivo.</span>
        </h1>

        <p class="mt-4 max-w-xl text-base leading-7 text-slate-600 sm:text-lg">
          Convierte y comprime imágenes directamente en el navegador. Sin cuentas, sin esperas y sin
          que un solo byte viaje a un servidor. Audio, vídeo y documentos llegarán en próximas fases.
        </p>

        <div id="buscador" class="mt-6 scroll-mt-24">
          <ToolSearch />
        </div>

        <div class="mt-3 flex flex-wrap gap-2">
          <a
            href="/convertir"
            class="inline-flex h-9 items-center gap-1.5 rounded-lg bg-brand-50 px-3 text-xs font-semibold text-brand-800 ring-1 ring-inset ring-brand-200 transition-colors hover:bg-brand-100"
          >
            Convertir imágenes
            <Icon name="arrow-right" size={13} />
          </a>
          <a
            href="/imagenes/reducir-foto-a-kb"
            class="inline-flex h-9 items-center rounded-lg px-3 text-xs font-semibold text-slate-600 ring-1 ring-inset ring-slate-200 transition-colors hover:bg-slate-50"
          >
            Reducir a KB
          </a>
          <a
            href="/imagenes/quitar-exif-foto"
            class="inline-flex h-9 items-center rounded-lg px-3 text-xs font-semibold text-slate-600 ring-1 ring-inset ring-slate-200 transition-colors hover:bg-slate-50"
          >
            Quitar EXIF
          </a>
        </div>

        <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-xs font-medium text-slate-500">
          <li class="flex items-center gap-1.5">
            <Icon name="shield" size={15} class="text-brand-600" />
            0 bytes subidos
          </li>
          <li class="flex items-center gap-1.5">
            <Icon name="wifi-off" size={15} class="text-brand-600" />
            Funciona sin conexión
          </li>
          <li class="flex items-center gap-1.5">
            <Icon name="zap" size={15} class="text-brand-600" />
            Sin registro
          </li>
        </ul>
      </div>

      <div class="relative mx-auto w-full max-w-sm lg:max-w-none" aria-hidden="true">
        <div
          class="absolute -inset-4 rounded-[2rem] bg-gradient-to-br from-brand-100/70 via-white to-slate-100 blur-2xl"
        >
        </div>

        <div class="relative rounded-3xl border border-slate-200 bg-white p-4 shadow-lift sm:p-5">
          <div class="flex items-center justify-between">
            <div class="flex gap-1.5">
              <span class="h-2.5 w-2.5 rounded-full bg-red-300"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-amber-300"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-emerald-300"></span>
            </div>
            <span
              class="inline-flex items-center gap-1 rounded-full bg-brand-50 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-brand-700"
            >
              <Icon name="lock" size={10} />
              100% local
            </span>
          </div>

          <div class="mt-4 rounded-2xl border border-slate-200 bg-slate-50 p-4">
            <div class="flex items-center gap-3">
              <span
                class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white text-[10px] font-bold text-rose-600 shadow-sm ring-1 ring-slate-200"
              >
                JPG
              </span>
              <div class="min-w-0 flex-1">
                <p class="truncate text-sm font-semibold text-slate-900">receta.jpg</p>
                <p class="text-xs text-slate-400">2,4 MB</p>
              </div>
              <span class="text-[10px] font-semibold text-brand-700">Listo</span>
            </div>

            <div class="my-4 flex items-center gap-2 text-[10px] text-slate-400">
              <span class="h-px flex-1 bg-slate-200"></span>
              convertido en 0,8 s
              <span class="h-px flex-1 bg-slate-200"></span>
            </div>

            <div class="flex items-center gap-3">
              <span
                class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white text-[10px] font-bold text-brand-700 shadow-sm ring-1 ring-slate-200"
              >
                PNG
              </span>
              <div class="min-w-0 flex-1">
                <p class="truncate text-sm font-semibold text-slate-900">receta.png</p>
                <p class="text-xs text-slate-400">1,1 MB</p>
              </div>
              <span
                class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-700 text-white shadow-sm"
              >
                <Icon name="download" size={16} />
              </span>
            </div>
          </div>

          <div
            class="mt-3 flex items-center justify-between rounded-xl bg-brand-50 px-3 py-2.5 text-[11px] font-medium text-brand-800 ring-1 ring-inset ring-brand-100"
          >
            <span class="flex items-center gap-1.5">
              <Icon name="lock" size={13} />
              Procesado en este dispositivo
            </span>
            <Icon name="check" size={14} />
          </div>
        </div>

        <div
          class="absolute -left-3 -top-4 hidden rotate-[-3deg] rounded-xl border border-slate-200 bg-white px-3 py-2 text-[11px] font-medium text-slate-600 shadow-card sm:block"
        >
          <span class="flex items-center gap-1.5">
            <Icon name="wifi-off" size={13} class="text-brand-600" />
            Sin conexión
          </span>
        </div>
        <div
          class="absolute -bottom-10 right-4 hidden rotate-[3deg] rounded-xl border border-slate-200 bg-white px-3 py-2 text-[11px] font-medium text-slate-600 shadow-card sm:block"
        >
          <span class="flex items-center gap-1.5">
            <Icon name="smartphone" size={13} class="text-brand-600" />
            También en móvil
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
