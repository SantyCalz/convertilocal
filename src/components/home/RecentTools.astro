import Icon from '@/components/ui/Icon.astro';
---

<section
  id="recientes"
  class="container-page scroll-mt-20 pb-12 sm:pb-16"
  aria-labelledby="recientes-title"
  data-recent-section
>
  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-card sm:p-6">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="eyebrow">Tu actividad</p>
        <h2 id="recientes-title" class="mt-1 text-xl font-bold tracking-tight text-slate-900">
          Herramientas recientes
        </h2>
        <p class="mt-1 text-sm text-slate-500">
          Guardadas solo en este navegador. No se envían a ningún servidor.
        </p>
      </div>
      <span
        class="inline-flex w-fit items-center gap-1.5 rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-medium text-slate-500"
      >
        <Icon name="clock" size={13} />
        localStorage
      </span>
    </div>

    <div data-recent-tools class="mt-5">
      <div
        data-recent-empty
        class="rounded-xl border border-dashed border-slate-200 bg-slate-50/60 px-4 py-7 text-center"
      >
        <span
          class="mx-auto flex h-10 w-10 items-center justify-center rounded-xl bg-white text-slate-400 shadow-sm ring-1 ring-slate-200"
        >
          <Icon name="clock" size={19} />
        </span>
        <p class="mt-3 text-sm font-medium text-slate-700">Aún no has usado ninguna herramienta</p>
        <p class="mx-auto mt-1 max-w-sm text-xs leading-5 text-slate-500">
          Cuando proceses un archivo, aparecerá aquí para volver más rápido. Puedes borrar este
          historial cerrando la pestaña o limpiando los datos del sitio.
        </p>
        <a
          href="#herramientas"
          class="mt-4 inline-flex items-center gap-1.5 text-xs font-semibold text-brand-700 hover:text-brand-800"
        >
          Ver herramientas
          <Icon name="arrow-right" size={14} />
        </a>
      </div>
    </div>
  </div>
</section>
