---
import Icon from '@/components/ui/Icon.astro';
---

<div class="relative" data-tool-search>
  <label for="tool-search" class="sr-only">Buscar una herramienta</label>

  <div
    class="flex items-center gap-2 rounded-2xl border border-slate-300 bg-white p-1.5 shadow-sm transition focus-within:border-brand-500 focus-within:ring-4 focus-within:ring-brand-500/10"
  >
    <span class="pl-2 text-slate-400">
      <Icon name="search" size={20} />
    </span>
    <input
      id="tool-search"
      data-tool-search-input
      type="search"
      placeholder="Busca: PDF a texto, comprimir imagen…"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      role="combobox"
      aria-expanded="false"
      aria-controls="tool-search-results"
      aria-autocomplete="list"
      aria-label="Buscar herramientas"
      class="h-11 min-w-0 flex-1 border-0 bg-transparent px-0 text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-0"
    />
    <kbd
      class="mr-1.5 hidden rounded border border-slate-200 bg-slate-50 px-1.5 py-0.5 font-sans text-[10px] font-semibold text-slate-400 sm:inline"
    >
      /
    </kbd>
  </div>

  <div
    id="tool-search-results"
    data-tool-search-results
    role="listbox"
    aria-label="Resultados de búsqueda"
    hidden
    class="absolute z-30 mt-2 max-h-80 w-full overflow-y-auto overscroll-contain rounded-2xl border border-slate-200 bg-white p-1.5 shadow-lift"
  >
  </div>

  <p class="mt-2 px-1 text-[11px] text-slate-400">
    Prueba con «imagen», «audio», «PDF» o «CSV». Nada de lo que escribes sale del navegador.
  </p>
</div>

<script>
  import { initToolSearch } from '@/scripts/home/search';

  initToolSearch();
</script>
