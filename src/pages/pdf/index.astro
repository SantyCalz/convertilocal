---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import { PDF_TOOLS } from '@/data/pdf-tools';

const path = '/pdf';
const site = (Astro.site ?? new URL('https://convertilocal.com')).href.replace(/\/$/, '');
const absolute = `${site}${path}`;

const webApplicationSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Herramientas PDF de ConvertiLocal',
  url: absolute,
  description:
    'Suite de herramientas PDF que funciona en el navegador: unir, dividir, rotar, reordenar, convertir, marcar, numerar y comprimir sin subir archivos.',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requiere un navegador moderno con JavaScript habilitado',
  inLanguage: 'es',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  featureList: PDF_TOOLS.map((tool) => tool.h1),
  publisher: { '@type': 'Organization', name: 'ConvertiLocal', url: site },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Herramientas PDF', item: absolute },
  ],
};

const faqs = [
  {
    q: '¿Los PDF se suben a algún servidor?',
    a: 'No. Las herramientas usan PDF.js y pdf-lib dentro del navegador. El archivo se lee desde tu disco, se procesa en memoria y se descarga desde el mismo dispositivo. No hay una API que reciba el documento.',
  },
  {
    q: '¿Puedo usar estas herramientas sin conexión?',
    a: 'Sí, una vez que la página y sus recursos están cargados. La primera visita descarga el motor de PDF; después puedes seguir trabajando en modo avión. Las herramientas que rasterizan páginas también funcionan sin red.',
  },
  {
    q: '¿Hay límites de tamaño o de páginas?',
    a: 'Sí. Cada PDF puede ocupar hasta 30 MB y el lote completo hasta 100 MB. Las operaciones estructurales admiten hasta 300 páginas; la conversión a imágenes y la compresión máxima, hasta 100. Los límites protegen la memoria del móvil.',
  },
  {
    q: '¿Se conservan las firmas digitales?',
    a: 'No. Cualquier operación que modifique el PDF invalida las firmas digitales existentes. Si necesitas verificar una firma, conserva el original y trabaja sobre una copia.',
  },
  {
    q: '¿Qué pasa con los PDF protegidos con contraseña?',
    a: 'No se pueden abrir en esta fase. Quita la protección desde la aplicación que creó el documento, guarda una copia sin contraseña y vuelve a intentarlo.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Herramientas PDF de ConvertiLocal',
  numberOfItems: PDF_TOOLS.length,
  itemListElement: PDF_TOOLS.map((tool, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: tool.h1,
    url: `${site}/pdf/${tool.slug}`,
  })),
};
---

<BaseLayout
  title="Herramientas PDF locales"
  description="Une, divide, rota, reordena, convierte, marca, numera y comprime PDF desde tu navegador. Tus documentos no se suben a ningún servidor."
  path={path}
  schema={[webApplicationSchema, breadcrumbSchema, faqSchema, itemListSchema]}
>
  <section class="border-b border-slate-200 bg-white">
    <div class="container-page py-10 sm:py-14">
      <nav aria-label="Migas de pan" class="flex flex-wrap items-center gap-1.5 text-xs text-slate-400">
        <a href="/" class="transition-colors hover:text-brand-700">Inicio</a>
        <span aria-hidden="true">/</span>
        <span class="text-slate-600" aria-current="page">Herramientas PDF</span>
      </nav>

      <div class="mt-6 grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_360px] lg:gap-14">
        <div>
          <p class="inline-flex items-center gap-1.5 rounded-full bg-brand-50 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wide text-brand-700 ring-1 ring-inset ring-brand-100">
            <Icon name="lock" size={11} />
            100% en tu navegador
          </p>
          <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-950 sm:text-5xl">
            Herramientas PDF que no suben tus documentos
          </h1>
          <p class="mt-5 max-w-2xl text-sm leading-7 text-slate-600 sm:text-base">
            Una colección de utilidades para trabajar con PDF en tu dispositivo: unir, dividir,
            rotar, reordenar, convertir a imagen, poner marca de agua, numerar páginas y comprimir.
            Sin cuenta, sin cola de subida y sin copias en la nube.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href="/pdf/unir-pdf"
              class="inline-flex h-11 items-center justify-center gap-2 rounded-xl bg-brand-700 px-5 text-sm font-semibold text-white transition-colors hover:bg-brand-800"
            >
              Empezar con unir PDF
              <Icon name="arrow-right" size={15} />
            </a>
            <a
              href="#herramientas-pdf"
              class="inline-flex h-11 items-center justify-center gap-2 rounded-xl px-5 text-sm font-semibold text-slate-700 ring-1 ring-inset ring-slate-300 transition-colors hover:bg-slate-50"
            >
              Ver las 10 herramientas
            </a>
          </div>
          <ul class="mt-6 grid gap-2 text-xs text-slate-500 sm:grid-cols-2">
            <li class="flex items-center gap-2"><Icon name="shield" size={15} class="text-brand-600" /> Tus archivos no se suben</li>
            <li class="flex items-center gap-2"><Icon name="wifi-off" size={15} class="text-brand-600" /> Funciona sin conexión</li>
            <li class="flex items-center gap-2"><Icon name="zap" size={15} class="text-brand-600" /> Sin registro ni marcas de agua</li>
            <li class="flex items-center gap-2"><Icon name="smartphone" size={15} class="text-brand-600" /> Pensado también para el móvil</li>
          </ul>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-5">
          <h2 class="text-sm font-semibold text-slate-900">Qué puedes hacer aquí</h2>
          <ul class="mt-3 space-y-2.5 text-xs leading-5 text-slate-600">
            <li class="flex gap-2"><Icon name="check" size={14} class="mt-0.5 shrink-0 text-brand-600" /> Ver miniaturas reales antes de procesar.</li>
            <li class="flex gap-2"><Icon name="check" size={14} class="mt-0.5 shrink-0 text-brand-600" /> Elegir páginas, orden y rotación en una cuadrícula táctil.</li>
            <li class="flex gap-2"><Icon name="check" size={14} class="mt-0.5 shrink-0 text-brand-600" /> Descargar un archivo o un ZIP generado en el dispositivo.</li>
            <li class="flex gap-2"><Icon name="check" size={14} class="mt-0.5 shrink-0 text-brand-600" /> Comprobar el peso antes y después de comprimir.</li>
          </ul>
          <p class="mt-4 border-t border-slate-200 pt-3 text-[11px] leading-5 text-slate-400">
            Límites del MVP: 30 MB por PDF, 100 MB por lote, 300 páginas estructurales y 100 para
            rasterizar. Los PDF cifrados no se admiten.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="herramientas-pdf" class="container-page scroll-mt-20 py-10 sm:py-14" aria-labelledby="herramientas-pdf-title">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <p class="text-[10px] font-semibold uppercase tracking-wide text-brand-700">Colección PDF</p>
        <h2 id="herramientas-pdf-title" class="mt-1 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
          Diez herramientas, un mismo límite: nada sale de tu dispositivo
        </h2>
      </div>
      <a href="/metodologia" class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-700 hover:text-brand-800">
        Cómo verificamos la privacidad
        <Icon name="arrow-right" size={13} />
      </a>
    </div>

    <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        PDF_TOOLS.map((tool) => (
          <a
            href={`/pdf/${tool.slug}`}
            class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-5 transition-all hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-card"
          >
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-50 text-brand-700 ring-1 ring-inset ring-brand-100">
              <Icon name="file-text" size={19} />
            </span>
            <h3 class="mt-3 text-base font-semibold text-slate-900 group-hover:text-brand-800">
              {tool.h1}
            </h3>
            <p class="mt-1.5 flex-1 text-xs leading-5 text-slate-500">{tool.description}</p>
            <span class="mt-3 inline-flex items-center gap-1.5 text-xs font-semibold text-brand-700">
              Abrir herramienta
              <Icon name="arrow-right" size={13} />
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="border-y border-slate-200 bg-slate-50/60 py-10 sm:py-14" aria-labelledby="limites-pdf-title">
    <div class="container-page grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-14">
      <div>
        <h2 id="limites-pdf-title" class="text-2xl font-bold tracking-tight text-slate-900">
          Lo que sí y lo que no hace esta fase
        </h2>
        <p class="mt-3 text-sm leading-7 text-slate-600">
          El objetivo es que las operaciones habituales funcionen bien y sean predecibles, no
          prometer compatibilidad total con cualquier PDF. Estos son los límites que aplicamos.
        </p>
        <ul class="mt-4 space-y-2 text-sm leading-6 text-slate-600">
          <li>· Hasta 30 MB por PDF y 100 MB por lote.</li>
          <li>· 300 páginas para unir, dividir, rotar, reordenar, marcar o numerar.</li>
          <li>· 100 páginas para convertir a JPG/PNG o aplicar la compresión máxima.</li>
          <li>· Marcadores, formularios y firmas digitales pueden no conservarse al reconstruir un documento.</li>
        </ul>
      </div>
      <div class="rounded-2xl border border-amber-200 bg-amber-50/80 p-5">
        <h3 class="text-sm font-semibold text-amber-900">Aviso sobre la compresión máxima</h3>
        <p class="mt-2 text-xs leading-5 text-amber-800">
          La opción de máxima compresión convierte cada página en una imagen JPEG. El archivo puede
          pesar mucho menos, pero el texto deja de ser seleccionable y se pierden enlaces,
          formularios y otras capas interactivas. Para contratos, apuntes o documentos que debas
          buscar, usa primero «Optimizar sin perder texto».
        </p>
        <a href="/pdf/comprimir-pdf" class="mt-3 inline-flex items-center gap-1.5 text-xs font-semibold text-amber-900 underline decoration-amber-300 underline-offset-2">
          Ver comprimir PDF
          <Icon name="arrow-right" size={13} />
        </a>
      </div>
    </div>
  </section>

  <section class="container-page py-10 sm:py-14" aria-labelledby="faq-pdf-title">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-14">
      <div>
        <h2 id="faq-pdf-title" class="text-2xl font-bold tracking-tight text-slate-900">
          Preguntas frecuentes
        </h2>
        <div class="mt-4 divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white">
          {
            faqs.map((item) => (
              <details class="group p-4">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-sm font-semibold text-slate-900">
                  {item.q}
                  <Icon name="chevron-down" size={16} class="shrink-0 text-slate-400 transition-transform group-open:rotate-180" />
                </summary>
                <p class="mt-2 text-sm leading-6 text-slate-600">{item.a}</p>
              </details>
            ))
          }
        </div>
      </div>
      <aside class="rounded-2xl border border-brand-200 bg-brand-50/60 p-5">
        <h2 class="text-sm font-semibold text-brand-900">También con imágenes</h2>
        <p class="mt-2 text-xs leading-5 text-brand-800/80">
          Convierte, comprime y limpia metadatos de fotos con las herramientas de imagen de
          ConvertiLocal. El mismo principio: el archivo se queda en tu dispositivo.
        </p>
        <a href="/convertir" class="mt-3 inline-flex items-center gap-1.5 text-xs font-semibold text-brand-800 hover:text-brand-900">
          Herramientas de imagen
          <Icon name="arrow-right" size={13} />
        </a>
      </aside>
    </div>
    <p class="mt-8 text-[11px] text-slate-400">Contenido revisado el 2026-10-21.</p>
  </section>
</BaseLayout>
