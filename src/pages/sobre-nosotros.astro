 * Copyright (C) 2026 ConvertiLocal contributors
 * SPDX-License-Identifier: AGPL-3.0-only
 */
import LegalLayout from '@/layouts/LegalLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import { LEGAL_PAGES, SITE } from '@/data/site';

const page = LEGAL_PAGES.nosotros;

const principles = [
  {
    icon: 'shield' as const,
    title: 'Privacidad por defecto',
    text: 'Si una función exige subir archivos, no la construimos. La conversión ocurre en tu dispositivo.',
  },
  {
    icon: 'zap' as const,
    title: 'Rápido y sin cuentas',
    text: 'Sin registro, sin correos de confirmación y sin límites artificiales de subida. Abres, conviertes y sigues.',
  },
  {
    icon: 'smartphone' as const,
    title: 'Móvil primero',
    text: 'Diseñamos desde 360 px, con zonas táctiles grandes, barra de acción fija y gestos reales.',
  },
  {
    icon: 'wifi-off' as const,
    title: 'Funciona sin conexión',
    text: 'Cuando una herramienta está cargada, puede seguir trabajando en modo avión.',
  },
];
---

<LegalLayout page={page}>
  <p>
    ConvertiLocal nace de una idea sencilla: convertir un archivo no debería obligarte a entregar
    tus documentos a un servidor desconocido. La mayoría de las conversiones caben en tu navegador;
    solo hacía falta construir la interfaz adecuada.
  </p>

  <h2>Por qué local-first</h2>
  <p>
    Las herramientas de conversión tradicionales funcionan subiendo el archivo, procesándolo en la
    nube y devolviéndote el resultado. Ese modelo tiene ventajas, pero también costes evidentes:
    esperas, límites de tamaño, cuentas, retención de datos y una pregunta incómoda: ¿qué ocurre
    realmente con mis archivos?
  </p>
  <p>
    ConvertiLocal invierte el modelo. El archivo se queda en tu dispositivo y el navegador hace el
    trabajo mediante JavaScript, WebAssembly, Web Workers y APIs nativas como OffscreenCanvas o Web
    Audio. El servidor solo entrega la página y las herramientas.
  </p>

  <div class="callout">
    <p>
      <strong>Nuestra promesa:</strong> si un archivo tiene que salir de tu dispositivo para que una
      función funcione, esa función no forma parte de ConvertiLocal.
    </p>
  </div>

  <h2>Principios de producto</h2>
  <div class="my-6 grid gap-3 sm:grid-cols-2">
    {
      principles.map((principle) => (
        <div class="rounded-2xl border border-slate-200 bg-white p-4">
          <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-50 text-brand-700 ring-1 ring-inset ring-brand-100">
            <Icon name={principle.icon} size={18} />
          </span>
          <h3 class="mt-3 text-sm font-semibold text-slate-900">{principle.title}</h3>
          <p class="mt-1 text-xs leading-5 text-slate-500">{principle.text}</p>
        </div>
      ))
    }
  </div>

  <h2>Lo que no hacemos</h2>
  <ul>
    <li>No pedimos registro ni creamos cuentas de usuario.</li>
    <li>No subimos tus archivos a la nube.</li>
    <li>No vendemos datos personales ni creamos perfiles publicitarios propios.</li>
    <li>No usamos patrones oscuros para retenerte o hacerte pagar por lo básico.</li>
    <li>No prometemos conversiones que el navegador no pueda completar con garantías.</li>
  </ul>

  <h2>Cómo se financia</h2>
  <p>
    El proyecto es gratuito y se mantiene con publicidad no invasiva de Google AdSense. Los anuncios
    se muestran fuera del flujo principal de trabajo y nunca bloquean una conversión. Si la
    publicidad no cubre los costes, exploraremos donaciones o licencias, pero el núcleo seguirá
    siendo local y gratuito.
  </p>

  <h2>Dónde estamos</h2>
  <p>
    La Fase 0 estableció la base técnica: arquitectura estática, sistema de diseño, componentes
    reutilizables, tipado del contrato de procesadores y páginas legales. La Fase 1 publica las
    primeras herramientas reales: veinte conversiones de imagen, compresión a un peso concreto y
    limpieza de metadatos. Las siguientes fases añadirán más formatos y herramientas de audio,
    vídeo y documentos.
  </p>
  <p>
    No publicamos una herramienta hasta que funciona en los navegadores objetivo, con archivos
    reales y sin subidas. Puedes consultar el proceso en la
    <a href="/metodologia">página de metodología</a>.
  </p>

  <h2>Quién está detrás</h2>
  <p>
    ConvertiLocal es un proyecto independiente. No hay una gran empresa detrás ni un equipo de
    ventas: hay desarrollo de producto, pruebas constantes y la intención de construir una utilidad
    duradera. Si quieres colaborar, reportar un error o proponer una herramienta, escríbenos.
  </p>

  <h2>Contacto</h2>
  <p>
    Puedes escribirnos a <a href={`mailto:${SITE.email}`}>{SITE.email}</a> o desde la
    <a href="/contacto">página de contacto</a>. Leemos todas las propuestas, aunque no siempre
    podamos responder con la rapidez que nos gustaría.
  </p>
</LegalLayout>
