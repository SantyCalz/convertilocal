---
import FileProcessor from '@/components/FileProcessor.astro';
import Icon from '@/components/ui/Icon.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const checks = [
  'Arrastra una o varias imágenes sobre la zona de carga.',
  'Pega una captura de pantalla con Ctrl/Cmd+V en cualquier punto visible.',
  'En móvil, abre el selector y comprueba la captura desde cámara.',
  'Procesa y verifica la barra de progreso y el botón de descarga.',
  'En iOS, comprueba que aparece el menú de compartir/guardar del sistema.',
  'Abre la pestaña Red: al procesar no debe salir ninguna petición con el archivo.',
];
---

<BaseLayout
  title="Laboratorio FileProcessor"
  description="Página interna de pruebas del componente base de procesado. No indexada."
  noindex
>
  <div class="container-page max-w-3xl py-8 sm:py-12">
    <a
      href="/"
      class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-500 transition-colors hover:text-slate-900"
    >
      <Icon name="arrow-right" size={14} class="rotate-180" />
      Volver al inicio
    </a>

    <div class="mt-5 flex flex-wrap items-center gap-2">
      <span
        class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-2.5 py-1 text-[11px] font-semibold text-amber-700 ring-1 ring-inset ring-amber-200"
      >
        <Icon name="sparkles" size={12} />
        Laboratorio interno
      </span>
      <span
        class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-medium text-slate-500"
      >
        noindex
      </span>
    </div>

    <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
      FileProcessor
    </h1>
    <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-600 sm:text-base">
      Banco de pruebas del componente interactivo base. Usa un procesador de laboratorio que copia
      los bytes y renombra la imagen: sirve para validar arrastre, pegado, progreso y descarga sin
      añadir librerías de conversión.
    </p>

    <div class="mt-7">
      <FileProcessor
        id="processor-demo"
        title="Duplicar imagen (demo)"
        description="Selecciona una imagen y se generará una copia con el sufijo indicado. Nada sale del navegador."
        processorId="passthrough"
        accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp"
        acceptLabel="PNG, JPG o WebP"
        multiple
        capture="environment"
        maxSizeMB={50}
        actionLabel="Duplicar imagen"
        baseName="convertilocal-demo"
        options={[
          {
            id: 'suffix',
            label: 'Sufijo del archivo',
            type: 'text',
            defaultValue: '-copia',
            placeholder: '-copia',
            help: 'Se añade antes de la extensión. Solo en esta demo.',
          },
        ]}
      />
    </div>

    <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-5" aria-labelledby="qa-title">
      <h2 id="qa-title" class="text-sm font-semibold text-slate-900">Checklist de QA</h2>
      <ul class="mt-3 space-y-2.5">
        {
          checks.map((check) => (
            <li class="flex items-start gap-2.5 text-xs leading-5 text-slate-600">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded border border-slate-300 bg-slate-50 text-slate-400">
                <Icon name="check" size={11} />
              </span>
              {check}
            </li>
          ))
        }
      </ul>
      <p class="mt-4 rounded-xl bg-slate-50 px-3 py-2.5 text-[11px] leading-5 text-slate-500">
        Esta página no aparece en el catálogo, no se incluye en el sitemap y lleva
        <code class="rounded bg-white px-1 py-0.5 font-mono text-[10px] text-slate-700">noindex</code
        >. Se eliminará cuando termine la QA de la Fase 1.
      </p>
    </section>
  </div>

  <script>
    import { recordToolUse } from '@/scripts/home/recent';

    const processor = document.querySelector('[data-file-processor]');
    processor?.addEventListener('convertilocal:processed', () => {
      recordToolUse('file-processor-demo');
    });
  </script>
</BaseLayout>
