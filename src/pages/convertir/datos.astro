 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import { DATA_TOOLS, TEXT_TOOL_SLUGS } from '@/data/data-tools';
import { SITE_URL } from '@/data/site';

const dataTools = DATA_TOOLS.filter((tool) => !TEXT_TOOL_SLUGS.has(tool.slug));
const path = '/convertir/datos';
const site = SITE_URL;
const absolute = `${site}${path}`;

const webApplicationSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Convertir datos en tu navegador',
  url: absolute,
  description: 'Convierte CSV, JSON, XLSX, YAML y XML sin subir archivos.',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  inLanguage: 'es',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  featureList: dataTools.map((tool) => tool.h1),
  publisher: { '@type': 'Organization', name: 'ConvertiLocal', url: site },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Convertir datos', item: absolute },
  ],
};

const faqs = [
  { q: '¿Los datos se suben a un servidor?', a: 'No. La conversión se ejecuta en tu navegador.' },
  { q: '¿Qué formatos se admiten?', a: 'CSV, JSON, XLSX, YAML y XML.' },
  { q: '¿Hay límite de tamaño?', a: 'Sí, 10 MB por archivo y 50 MB por lote.' },
  { q: '¿Se conservan los datos anidados?', a: 'Los objetos anidados se serializan como texto cuando el formato de destino es tabular.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
};
---

<BaseLayout
  title="Convertir datos sin subir archivos"
  description="Convierte CSV, JSON, XLSX, YAML y XML en tu navegador. Sin subidas, sin registro y con control de delimitador."
  path={path}
  schema={[webApplicationSchema, breadcrumbSchema, faqSchema]}
>
  <section class="border-b border-slate-200 bg-white">
    <div class="container-page py-10 sm:py-14">
      <nav aria-label="Migas de pan" class="flex flex-wrap items-center gap-1.5 text-xs text-slate-400">
        <a href="/" class="transition-colors hover:text-brand-700">Inicio</a>
        <span aria-hidden="true">/</span>
        <span class="text-slate-600" aria-current="page">Convertir datos</span>
      </nav>
      <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-950 sm:text-5xl">Convertir datos sin subirlos</h1>
      <p class="mt-5 max-w-2xl text-sm leading-7 text-slate-600 sm:text-base">
        Convierte CSV, JSON, XLSX, YAML y XML en tu dispositivo. Sin cuenta, sin cola de subida y sin copias en la nube.
      </p>
    </div>
  </section>

  <section class="container-page py-10 sm:py-14">
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {dataTools.map((tool) => (
        <a href={`/convertir/${tool.slug}`} class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-5 transition-all hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-card">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-50 text-brand-700 ring-1 ring-inset ring-brand-100">
            <Icon name="table" size={19} />
          </span>
          <h2 class="mt-3 text-base font-semibold text-slate-900 group-hover:text-brand-800">{tool.h1}</h2>
          <p class="mt-1.5 flex-1 text-xs leading-5 text-slate-500">{tool.description}</p>
          <span class="mt-3 inline-flex items-center gap-1.5 text-xs font-semibold text-brand-700">
            Abrir herramienta
            <Icon name="arrow-right" size={13} />
          </span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
