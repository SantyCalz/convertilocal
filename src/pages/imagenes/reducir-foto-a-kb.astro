 * Copyright (C) 2026 ConvertiLocal contributors
 * SPDX-License-Identifier: AGPL-3.0-only
 */
import ToolPageShell from '@/components/tools/ToolPageShell.astro';
import Icon from '@/components/ui/Icon.astro';
import type { ProcessorOption } from '@/types/processor';

const path = '/imagenes/reducir-foto-a-kb';
const site = (Astro.site ?? new URL('https://convertilocal.com')).href.replace(/\/$/, '');
const faqs = [
  {
    q: '¿Qué diferencia hay entre KB y KiB?',
    a: 'En esta herramienta 1 KB equivale a 1024 bytes, la convención que usan la mayoría de sistemas y límites de subida. Algunos formularios muestran KiB con el mismo número; si el límite es estricto, deja un margen de unos pocos KB.',
  },
  {
    q: '¿Se puede comprimir un PNG a un peso exacto?',
    a: 'No de forma honesta sin cambiar de formato. PNG es sin pérdida y su tamaño depende de la imagen. Esta herramienta genera JPG, WebP o AVIF cuando buscas un peso concreto, porque son formatos con pérdida controlable.',
  },
  {
    q: '¿Qué pasa si no se alcanza el peso objetivo?',
    a: 'La herramienta reduce la calidad y, si lo permites, las dimensiones. Si aun así no llega, te avisa y entrega el archivo más pequeño que pudo generar. Para objetivos muy bajos, reduce también el ancho máximo.',
  },
  {
    q: '¿La foto se sube al servidor?',
    a: 'No. La decodificación, la búsqueda de calidad y la codificación se ejecutan en un Web Worker dentro de tu navegador.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Convertir imágenes', item: `${site}/convertir` },
    { '@type': 'ListItem', position: 3, name: 'Reducir foto a KB', item: `${site}${path}` },
  ],
};

const options: ProcessorOption[] = [
  {
    id: 'format',
    label: 'Formato de salida',
    type: 'select',
    defaultValue: 'jpg',
    choices: [
      { value: 'jpg', label: 'JPG · máxima compatibilidad' },
      { value: 'webp', label: 'WebP · buen equilibrio' },
      { value: 'avif', label: 'AVIF · menor peso' },
    ],
    help: 'Para un peso objetivo se usa un formato con pérdida controlable.',
  },
  {
    id: 'mode',
    label: 'Modo de compresión',
    type: 'select',
    defaultValue: 'target',
    choices: [
      { value: 'target', label: 'Peso objetivo (KB)' },
      { value: 'quality', label: 'Calidad manual' },
    ],
  },
  {
    id: 'targetKb',
    label: 'Peso objetivo',
    type: 'number',
    defaultValue: 100,
    min: 5,
    max: 10240,
    step: 5,
    unit: 'KB',
    help: 'Entre 5 y 10.240 KB. 1 KB = 1024 bytes.',
    showWhen: { id: 'mode', equals: 'target' },
  },
  {
    id: 'quality',
    label: 'Calidad',
    type: 'range',
    defaultValue: 82,
    min: 30,
    max: 100,
    step: 1,
    unit: '%',
    help: 'Solo se aplica en el modo de calidad manual.',
    showWhen: { id: 'mode', equals: 'quality' },
  },
  {
    id: 'allowDownscale',
    label: 'Permitir reducir las dimensiones',
    type: 'checkbox',
    defaultValue: true,
    help: 'Si el peso no baja solo con calidad, se reduce el ancho y el alto de forma progresiva.',
    showWhen: { id: 'mode', equals: 'target' },
  },
  {
    id: 'maxWidth',
    label: 'Ancho máximo',
    type: 'number',
    defaultValue: 0,
    min: 0,
    max: 16384,
    step: 100,
    unit: 'px',
    help: '0 mantiene el tamaño original. Útil para limitar fotos de móvil.',
  },
  {
    id: 'background',
    label: 'Color de fondo',
    type: 'select',
    defaultValue: '#ffffff',
    choices: [
      { value: '#ffffff', label: 'Blanco' },
      { value: '#000000', label: 'Negro' },
      { value: '#f1f5f9', label: 'Gris claro' },
    ],
    help: 'Se usa al convertir transparencia a JPG.',
  },
];
---

<ToolPageShell
  title="Reducir foto a KB online sin subirla"
  description="Comprime una foto a un peso concreto en KB o ajusta la calidad manualmente. JPG, WebP o AVIF, todo en tu navegador y sin subidas."
  h1="Reducir foto a KB"
  intro="Muchos formularios, correos y plataformas limitan el peso de las imágenes. Esta herramienta busca la mejor calidad posible que quepa en el objetivo que indiques, reduciendo dimensiones solo si hace falta."
  path={path}
  processorId="image-compress"
  accept=".jpg,.jpeg,.png,.webp,.avif,.bmp,.ico,image/jpeg,image/png,image/webp,image/avif,image/bmp,image/x-icon"
  acceptLabel="JPG, PNG, WebP, AVIF, BMP o ICO"
  actionLabel="Comprimir imágenes"
  baseName="foto-reducida"
  options={options}
  resultNote="El peso final puede variar unos KB según el códec del navegador. Si el objetivo es un límite estricto, deja un margen."
  schema={[breadcrumbSchema, faqSchema]}
  breadcrumbLabel="Reducir foto a KB"
>
  <section aria-labelledby="como-title">
    <h2 id="como-title" class="text-2xl font-bold tracking-tight text-slate-900">
      Cómo encontramos el peso objetivo
    </h2>
    <div class="mt-4 space-y-4 text-sm leading-7 text-slate-600 sm:text-base">
      <p>
        La herramienta decodifica la imagen y prueba varias calidades de compresión. En cada intento
        mide el tamaño real del archivo y ajusta la calidad hacia arriba o hacia abajo, como una
        búsqueda binaria. Si ninguna calidad cabe en el objetivo y has permitido reducir dimensiones,
        encoge la imagen un 15% y vuelve a intentarlo.
      </p>
      <p>
        No se puede prometer un peso exacto al byte: JPG, WebP y AVIF tienen overhead de cabecera y
        el resultado depende del códec del navegador. Sí podemos garantizar que el archivo entregado
        es el más cercano por debajo del objetivo, salvo que sea imposible incluso con la calidad
        mínima. En ese caso verás un aviso.
      </p>
    </div>
  </section>

  <section class="mt-10" aria-labelledby="limites-title">
    <h2 id="limites-title" class="text-2xl font-bold tracking-tight text-slate-900">
      Qué formato elegir para un límite de peso
    </h2>
    <div class="mt-4 grid gap-3 sm:grid-cols-3">
      <div class="rounded-2xl border border-slate-200 bg-white p-4">
        <h3 class="text-sm font-semibold text-slate-900">JPG</h3>
        <p class="mt-1 text-xs leading-5 text-slate-500">Abre en todas partes. Ideal para formularios antiguos y correo. No conserva transparencia.</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-4">
        <h3 class="text-sm font-semibold text-slate-900">WebP</h3>
        <p class="mt-1 text-xs leading-5 text-slate-500">Suele pesar menos que JPG y admite alfa. Compatible con navegadores modernos y muchos CMS.</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-4">
        <h3 class="text-sm font-semibold text-slate-900">AVIF</h3>
        <p class="mt-1 text-xs leading-5 text-slate-500">El menor peso en muchas fotos, pero codifica más lento y tiene menos compatibilidad fuera de la web.</p>
      </div>
    </div>
  </section>

  <section class="mt-10" aria-labelledby="errores-title">
    <h2 id="errores-title" class="text-2xl font-bold tracking-tight text-slate-900">
      Tres errores al reducir el peso
    </h2>
    <ol class="mt-4 space-y-3">
      <li class="flex gap-3 rounded-2xl border border-slate-200 bg-slate-50/60 p-4">
        <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-white text-xs font-bold text-slate-500 ring-1 ring-slate-200">1</span>
        <div>
          <h3 class="text-sm font-semibold text-slate-900">Pedir 20 KB para una foto grande</h3>
          <p class="mt-1 text-xs leading-5 text-slate-500">Para lograrlo hay que reducir mucho la resolución y la calidad. Si el objetivo es muy bajo, baja también el ancho máximo o recorta la imagen.</p>
        </div>
      </li>
      <li class="flex gap-3 rounded-2xl border border-slate-200 bg-slate-50/60 p-4">
        <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-white text-xs font-bold text-slate-500 ring-1 ring-slate-200">2</span>
        <div>
          <h3 class="text-sm font-semibold text-slate-900">Comprimir un PNG con texto</h3>
          <p class="mt-1 text-xs leading-5 text-slate-500">Si el PNG es una captura con letras, JPG puede emborronarlas. Prueba WebP de calidad alta o mantén PNG y reduce las dimensiones.</p>
        </div>
      </li>
      <li class="flex gap-3 rounded-2xl border border-slate-200 bg-slate-50/60 p-4">
        <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-white text-xs font-bold text-slate-500 ring-1 ring-slate-200">3</span>
        <div>
          <h3 class="text-sm font-semibold text-slate-900">Recomprimir el archivo ya comprimido</h3>
          <p class="mt-1 text-xs leading-5 text-slate-500">Cada ciclo añade artefactos. Guarda el original y genera la versión ligera una sola vez.</p>
        </div>
      </li>
    </ol>
  </section>

  <section class="mt-10" aria-labelledby="faq-title">
    <h2 id="faq-title" class="text-2xl font-bold tracking-tight text-slate-900">Preguntas frecuentes</h2>
    <div class="mt-4 divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white">
      {faqs.map((item) => (
        <details class="group p-4">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-sm font-semibold text-slate-900">
            {item.q}
            <Icon name="chevron-down" size={16} class="shrink-0 text-slate-400 transition-transform group-open:rotate-180" />
          </summary>
          <p class="mt-2 text-sm leading-6 text-slate-600">{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <Fragment slot="aside">
    <div class="mt-4 rounded-2xl border border-slate-200 bg-white p-5">
      <h2 class="text-sm font-semibold text-slate-900">Límites habituales</h2>
      <ul class="mt-2 space-y-2 text-xs leading-5 text-slate-500">
        <li><strong class="text-slate-700">100 KB:</strong> fotos de perfil y formularios de empleo.</li>
        <li><strong class="text-slate-700">200 KB:</strong> adjuntos de correo y trámites.</li>
        <li><strong class="text-slate-700">500 KB:</strong> imágenes de blog con buena calidad.</li>
        <li><strong class="text-slate-700">1 MB:</strong> fotos grandes para web o impresión básica.</li>
      </ul>
    </div>
    <div class="mt-4 rounded-2xl border border-brand-200 bg-brand-50/60 p-5">
      <h2 class="text-sm font-semibold text-brand-900">¿También quieres privacidad?</h2>
      <p class="mt-1 text-xs leading-5 text-brand-800/80">Elimina GPS y datos de cámara sin recomprimir la imagen.</p>
      <a href="/imagenes/quitar-exif-foto" class="mt-2 inline-flex items-center gap-1.5 text-xs font-semibold text-brand-800 hover:text-brand-900">
        Quitar EXIF
        <Icon name="arrow-right" size={13} />
      </a>
    </div>
  </Fragment>
</ToolPageShell>
