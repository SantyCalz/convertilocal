import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import { DATA_TOOLS, TEXT_TOOL_SLUGS } from '@/data/data-tools';
import { SITE_URL } from '@/data/site';
import AdSlot from '@/components/AdSlot.astro';

const textTools = DATA_TOOLS.filter((tool) => TEXT_TOOL_SLUGS.has(tool.slug));
const path = '/texto';
const site = SITE_URL;
const absolute = `${site}${path}`;

const webApplicationSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Herramientas de texto',
  url: absolute,
  description: 'Convierte Markdown y HTML, limpia texto y cuenta palabras sin subir archivos.',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  inLanguage: 'es',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  featureList: textTools.map((tool) => tool.h1),
  publisher: { '@type': 'Organization', name: 'ConvertiLocal', url: site },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Texto', item: absolute },
  ],
};

const faqs = [
  { q: '¿El texto se sube a un servidor?', a: 'No. Todo se procesa en tu navegador.' },
  { q: '¿Se puede limpiar texto con acentos?', a: 'Sí. La limpieza conserva los caracteres Unicode.' },
  { q: '¿Hay límite de tamaño?', a: 'Sí, 5 MB por archivo para mantener la página fluida.' },
  { q: '¿Funciona sin conexión?', a: 'Sí, una vez cargada la página.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
};
---

<BaseLayout
  title="Herramientas de texto sin subir archivos"
  description="Convierte Markdown y HTML, limpia texto y cuenta palabras en tu navegador. Sin subidas ni registro."
  path={path}
  schema={[webApplicationSchema, breadcrumbSchema, faqSchema]}
>
  <section class="border-b border-slate-200 bg-white">
    <div class="container-page py-10 sm:py-14">
      <nav aria-label="Migas de pan" class="flex flex-wrap items-center gap-1.5 text-xs text-slate-400">
        <a href="/" class="transition-colors hover:text-brand-700">Inicio</a>
        <span aria-hidden="true">/</span>
        <span class="text-slate-600" aria-current="page">Texto</span>
      </nav>
      <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-950 sm:text-5xl">Herramientas de texto sin subirlas</h1>
      <p class="mt-5 max-w-2xl text-sm leading-7 text-slate-600 sm:text-base">
        Convierte Markdown y HTML, limpia formato y cuenta palabras en tu dispositivo.
      </p>
    </div>
  </section>

  <section class="container-page py-10 sm:py-14">
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {textTools.map((tool) => (
        <a href={`/texto/${tool.slug}`} class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-5 transition-all hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-card">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-50 text-brand-700 ring-1 ring-inset ring-brand-100">
            <Icon name="clipboard" size={19} />
          </span>
          <h2 class="mt-3 text-base font-semibold text-slate-900 group-hover:text-brand-800">{tool.h1}</h2>
          <p class="mt-1.5 flex-1 text-xs leading-5 text-slate-500">{tool.description}</p>
          <span class="mt-3 inline-flex items-center gap-1.5 text-xs font-semibold text-brand-700">
            Abrir herramienta
            <Icon name="arrow-right" size={13} />
          </span>
        </a>
      ))}
    </div>
    <AdSlot class="mt-10" minHeightMobile={100} minHeightDesktop={250} />
  </section>
</BaseLayout>
