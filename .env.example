# Origen público del sitio.
#
# Es la base de TODAS las URL absolutas: canónicas, og:url, og:image, los
# JSON-LD, el sitemap y la directiva Sitemap: de robots.txt. Debe coincidir
# con lo que responden las canónicas de las páginas generadas.
#
# Mientras convertilocal.com no tenga registros DNS activos, el subdominio de
# Vercel es el que responde y el que Google Search Console puede validar.
PUBLIC_SITE_URL=https://convertilocal.vercel.app

# Google AdSense. Déjalo vacío para desactivar anuncios y su script.
# Formato: ca-pub-XXXXXXXXXXXXXXXX
# El valor por defecto (ca-pub-3640204756657627) ya está en src/data/site.ts.
PUBLIC_ADSENSE_CLIENT=

# ID del bloque de anuncios (AdSense → Publicidad → Bloques de anuncios).
# Sin él se reserva el hueco en la portada, pero no se muestra ningún anuncio.
PUBLIC_ADSENSE_SLOT=

# Activa o desactiva AdSense y sus scripts sin tocar el código.
PUBLIC_ENABLE_ADS=true

# Origen público del repositorio con el código fuente (AGPL-3.0 §13).
PUBLIC_REPO_URL=https://github.com/SantyCalz/convertilocal

# Release con el código fuente correspondiente del binario de FFmpeg.
PUBLIC_SOURCE_RELEASE_URL=https://github.com/SantyCalz/convertilocal/releases/tag/corresponding-source-v1.0.0
