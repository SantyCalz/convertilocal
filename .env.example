# Dominio público (debe coincidir con astro.config.mjs y src/data/site.ts)
PUBLIC_SITE_URL=https://convertilocal.com

# Google AdSense. Déjalo vacío para desactivar anuncios y su script.
# Formato: ca-pub-XXXXXXXXXXXXXXXX
PUBLIC_ADSENSE_CLIENT=

# Activa o desactiva AdSense y sus scripts sin tocar el código.
PUBLIC_ENABLE_ADS=true
